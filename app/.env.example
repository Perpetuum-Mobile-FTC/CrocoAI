# Server
PORT=3001
NODE_ENV=production
TZ=Europe/Bucharest

# Public URL of the platform (links in WhatsApp messages)
APP_BASE_URL=https://crocoai.example.org

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_INITIAL_PASSWORD=change-me-admin-password
# First account (created once, on an empty database; the password must be changed at first login)
ADMIN_FULL_NAME=
ADMIN_USERNAME=admin
ADMIN_PHONE=
# Login attempts per IP per 15 min before 429 (default 10; raise only for automated tests)
LOGIN_RATE_LIMIT_MAX=10
# Signs the attendance QR codes (falls back to JWT_SECRET)
ATTENDANCE_QR_SECRET=

# WhatsApp gateway (a whatsapp-web.js bridge; see docs/instalare.md)
WA_GATEWAY_URL=http://moldfix-wa:8099
WA_SHARED_SECRET=change-me-shared-secret
# Optional key sent to the gateway as X-Lucid-Key
LUCID_INTERNAL_KEY=
# Docker network shared with the gateway (docker-compose.yml)
WA_NETWORK=crocoai-wa
# Owner's own number (digits, e.g. 407xxxxxxxx): private messages from it are handled only when they start with "croco".
OWNER_PHONE=
# Team WhatsApp group for event announcements (e.g. 1203...@g.us); empty = in-app notifications only
TEAM_GROUP_ID=
# Registration codes sent per IP per hour (default 30: a school Wi-Fi shares one address); per phone: 3/hour (fixed)
# OTP_MAX_PER_IP_HOUR=30

# Documents (GDPR/participation uploads). Defaults to <app>/data/documents if unset.
DOCUMENTS_DIR=

# AI agent (Claude Agent SDK, design v2 §8). ANTHROPIC_API_KEY is preferred; if unset, falls back
# to CLAUDE_CODE_OAUTH_TOKEN (temporary - owner's decision, audit A0 risk accepted until the
# team has its own API key). Both unset -> AI disabled elegantly, deterministic commands still work.
# /api/health reports ai_configured (any provider set) and ai_provider (provider in use, or "none").
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
AI_MODEL=claude-sonnet-5
# AI fallback chain (docs/design-ai-fallback.md): claude-main -> claude-backup -> qwen -> groq.
# Unset providers are skipped. GROQ_API_KEY (below, also used for transcription) enables Groq chat.
CLAUDE_CODE_OAUTH_TOKEN_BACKUP=
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_MODEL=qwen3.8
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Minutes a failed provider is skipped (unless its message has a reset time); per-call timeout (ms).
AI_PROVIDER_COOLDOWN_MIN=15
AI_PROVIDER_TIMEOUT_MS=90000
# Per-member daily AI call limit (LEADERS get x3); global daily token budget across all members.
AI_DAILY_LIMIT_MEMBER=30
AI_DAILY_TOKEN_BUDGET=400000
# Total AI cost (USD) per Europe/Bucharest day above which active Team Leaders are told once a day.
AI_DAILY_COST_ALERT_USD=2

# Meetings module (design-phase2.md §4). Transcription audio -> text (Groq Whisper); empty = no
# automatic transcription, PV completed manually.
GROQ_API_KEY=
# Google Meet link creation (team-owned OAuth refresh token); empty = manual Meet link only, never blocking.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TEAM_REFRESH_TOKEN=
# Where uploaded meeting audio is stored. Defaults to <app>/data/meetings if unset.
MEETINGS_AUDIO_DIR=

# Paced WhatsApp queue (persisted in SQLite, wa_queue): ms between sends, retry base delay, max attempts.
# WA_QUEUE_DELAY_MS=20000
# WA_QUEUE_RETRY_MS=60000
# WA_QUEUE_MAX_ATTEMPTS=5
